{
	"name": "@earendil-works/pi-desktop",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": ".pi-dev/electron-build/main.mjs",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"predev": "node scripts/build-file-viewer.mjs",
		"dev": "tsx src/host/main.ts",
		"predev:desktop": "node scripts/build-file-viewer.mjs",
		"dev:desktop": "node scripts/dev-desktop.mjs",
		"spike": "tsx src/host/spike.ts",
		"build": "tsgo -p tsconfig.json",
		"package:sidecar": "node scripts/package-sidecar.mjs",
		"package:manifest": "node scripts/write-release-manifest.mjs",
		"prepackage:windows": "node scripts/build-file-viewer.mjs",
		"package:windows": "node scripts/build-windows-installer.mjs",
		"migrate:sessions": "tsx scripts/session-migration.ts",
		"release:preflight": "node scripts/release-preflight.mjs",
		"test:e2e": "node scripts/test-slash-menu-e2e.mjs",
		"test:preview-e2e": "node scripts/test-file-preview-e2e.mjs",
		"test": "vitest --run test"
	},
	"dependencies": {
		"@earendil-works/pi-desktop-core": "0.1.0",
		"@earendil-works/pi-desktop-mcp": "0.1.0",
		"@earendil-works/pi-desktop-pi-bridge": "0.1.0",
		"@earendil-works/pi-desktop-protocol": "0.1.0",
		"@earendil-works/pi-desktop-storage": "0.1.0",
		"@open-file-viewer/core": "0.1.33",
		"lucide": "1.27.0",
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"electron": "43.2.0",
		"electron-builder": "26.15.3",
		"esbuild": "0.28.1",
		"playwright": "1.54.2",
		"tsx": "4.22.1",
		"vitest": "4.1.9"
	}
}
